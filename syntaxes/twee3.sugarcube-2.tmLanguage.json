{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Twee3-SugarCube",
    "patterns": [
        {
            "include": "#storydata"
        },
        {
            "include": "#scriptpassage"
        },
        {
            "include": "#stylesheetpassage"
        },
        {
            "include": "#passage"
        }
    ],
    "repository": {
        "storydata": {
            "comment": "Twee 3 StoryData passage",
            "begin": "^::\\s*(StoryData)\\s*?(?:(?<!\\\\)\\[(.*?)(?<!\\\\)\\]\\s*?)?((?<!\\\\)\\{.*?(?<!\\\\)\\}\\s*?)?$",
            "end": "^(?=::)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.type.class.twee3"
                },
                "2": {
                    "name": "variable.other.property.twee3"
                },
                "3": {
                    "name": "source.json.twee3",
                    "patterns": [
                        {
                            "include": "source.json"
                        }
                    ]
                }
            },
            "name": "source.json.twee3",
            "patterns": [
                {
                    "include": "source.json"
                }
            ]
        },
        "scriptpassage": {
            "comment": "Twee 3 passage with the [script] tag",
            "begin": "^::\\s*((?!=:).*?)\\s*?(?:(?<!\\\\)\\[(.*?\\bscript\\b.*?)(?<!\\\\)\\]\\s*?)((?<!\\\\)\\{.*?(?<!\\\\)\\}\\s*?)?$",
            "end": "^(?=::)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.type.class.twee3"
                },
                "2": {
                    "name": "variable.other.property.twee3"
                },
                "3": {
                    "name": "source.json.twee3",
                    "patterns": [
                        {
                            "include": "source.json"
                        }
                    ]
                }
            },
            "name": "source.js.twee3",
            "patterns": [
                {
                    "include": "source.js"
                }
            ]
        },
        "stylesheetpassage": {
            "comment": "Twee 3 passage with the [stylesheet] tag",
            "begin": "^::\\s*((?!=:).*?)\\s*?(?:(?<!\\\\)\\[(.*?\\bstylesheet\\b.*?)(?<!\\\\)\\]\\s*?)((?<!\\\\)\\{.*?(?<!\\\\)\\}\\s*?)?$",
            "end": "^(?=::)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.type.class.twee3"
                },
                "2": {
                    "name": "variable.other.property.twee3"
                },
                "3": {
                    "name": "source.json.twee3",
                    "patterns": [
                        {
                            "include": "source.json"
                        }
                    ]
                }
            },
            "name": "source.css.twee3",
            "patterns": [
                {
                    "include": "source.css"
                }
            ]
        },
        "passage": {
            "comment": "Twee 3 passage",
            "begin": "^::\\s*((?!=:).*?)\\s*?(?:(?<!\\\\)\\[(.*?)(?<!\\\\)\\]\\s*?)?((?<!\\\\)\\{.*?(?<!\\\\)\\}\\s*?)?$",
            "end": "^(?=::)",
            "beginCaptures": {
                "1": {
                    "name": "entity.name.type.class.twee3"
                },
                "2": {
                    "name": "variable.other.property.twee3"
                },
                "3": {
                    "name": "source.json.twee3",
                    "patterns": [
                        {
                            "include": "source.json"
                        }
                    ]
                }
            },
            "patterns": [
                {
                    "include": "#sugarcube-2-passage"
                }
            ],
            "name": "source.passagedata.twee3"
        },
        "sugarcube-2-passage": {
            "comment": "A Sugarcube-specific passage",
            "patterns": [
                {
                    "include": "#sugarcube-verbatim"
                },
                {
                    "include": "#sugarcube-nowiki"
                },
                {
                    "include": "#sugarcube-comments"
                },
                {
                    "include": "#sugarcube-macro-with-link"
                },
                {
                    "include": "#sugarcube-macro"
                },
                {
                    "include": "#sugarcube-variables"
                },
                {
                    "include": "#sugarcube-link"
                },
                {
                    "include": "#script-tag"
                },
                {
                    "include": "#style-tag"
                },
                {
                    "include": "#html-tag"
                }
            ]
        },
        "sugarcube-verbatim": {
            "comment": "Sugarcube 2 verbatim text",
            "begin": "\"\"\"",
            "end": "\"\"\""
        },
        "sugarcube-nowiki": {
            "comment": "Sugarcube 2 <nowiki> text",
            "begin": "(?i)<nowiki>",
            "end": "(?i)</nowiki>"
        },
        "sugarcube-code": {
            "comment": "Sugarcube 2 code",
            "begin": "\\{{3}",
            "end": "\\}{3}"
        },
        "sugarcube-comments": {
            "comment": "Sugarcube 2 comments",
            "patterns": [
                {
                    "include": "#sugarcube-comments-c"
                },
                {
                    "include": "#sugarcube-comments-tiddly"
                },
                {
                    "include": "#sugarcube-comments-html"
                }
            ]
        },
        "sugarcube-comments-c": {
            "comment": "Sugarcube 2 comments (C style)",
            "name": "comment.block",
            "begin": "(?<!\\/)\\/\\*",
            "end": "\\*\\/"
        },
        "sugarcube-comments-tiddly": {
            "comment": "Sugarcube 2 comments (TiddlyWiki style)",
            "name": "comment.block",
            "begin": "(?<!\\/)\\/%",
            "end": "%\\/"
        },
        "sugarcube-comments-html": {
            "comment": "Sugarcube 2 comments (HTML style)",
            "name": "comment.block",
            "begin": "<!--",
            "end": "-->"
        },
        "sugarcube-macro-with-link": {
            "comment": "Sugarcube 2 macro with an embedded passage link",
            "begin": "(?i)(<<\\/?)((?:\\=|\\-)|(?:[a-zA-Z][a-zA-Z0-9\\-_]*))(?=(\\s+\\[(?:img)?\\[)(.*?)(\\]\\]))",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "keyword.control.flow.js"
                }
            },
            "end": "(/?>>)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.end.html"
                }
            },
            "patterns": [
                { "include": "#sugarcube-link" },
                { "include": "#sugarcube-variables" },
                { "include": "#sugarcube-syntactic-sugar" }
            ]
        },
        "sugarcube-macro": {
            "name": "Sugarcube 2 macro",
            "begin": "(?i)(<<\\/?)((?:\\=|\\-)|(?:[a-zA-Z][a-zA-Z0-9\\-_]*))",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "keyword.control.flow.js"
                }
            },
            "end": "(/?>>)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.end.html"
                }
            },
            "patterns": [
                {
                    "include": "#sugarcube-link"
                },
                {
                    "include": "#sugarcube-variables"
                },
                {
                    "include": "#sugarcube-syntactic-sugar"
                },
                {
                    "name": "source.js.twee3",
                    "patterns": [
                        {
                            "include": "source.js"
                        }
                    ]
                }
            ]
        },
        "sugarcube-variables": {
            "match": "(?:(\\$|_)(?:[A-Za-z_\\$][A-Za-z0-9_\\$]*))((?:\\.[A-Za-z_\\$][A-Za-z0-9_\\$]*)*)\\b",
            "name": "entity.name.tag",
            "captures": {
                "1": {
                    "name": "punctuation.accessor"
                },
                "2": {
                    "patterns": [
                        {
                            "match": "\\.",
                            "name": "punctuation.accessor"
                        }
                    ]
                }
            }
        },
        "sugarcube-templates": {
            "match": "(\\?)([A-Za-z][A-Za-z0-9_\\-]*)\\b",
            "name": "entity.name.tag",
            "captures": {
                "1": {
                    "name": "punctuation.accessor"
                }
            }
        },
        "sugarcube-syntactic-sugar": {
            "match": "\\b(to|is|isnot|eq|neq|gt|gte|lt|lte|and|or|not|def|ndef|class)\\b",
            "name": "keyword.operator"
        },
        "sugarcube-link": {
            "comment": "Sugarcube 2 link",
            "name": "meta.link.twee3",
            "begin": "\\[\\[",
            "beginCaptures": {
                "0": { "name": "keyword.control.twee3" }
            },
            "end": "\\]\\]",
            "endCaptures": {
                "0": { "name": "keyword.control.twee3" }
            },
            "patterns": [
                { "include": "#sugarcube-link-core" },
                { "include": "#sugarcube-link-setter" }
            ]
        },
        "sugarcube-link-core": {
            "comment": "The inner parts of a Sugarcube link",
            "patterns": [
                { "include": "#sugarcube-link-image" },
                { "include": "#sugarcube-link-text" },
                { "include": "#sugarcube-link-separator" },
                { "include": "#sugarcube-link-target" }
            ]
        },
        "sugarcube-link-image": {
            "name": "meta.link.image.sugarcube",
            "match": "\\b[^\\s\\]|]+\\.(png|jpg|jpeg|gif|webp|svg)\\b",
            "captures": {
                "0": { "name": "string.link.image.path.twee3" }
            }
        },
        "sugarcube-link-text": {
            "comment": "Text in a Sugarcube link",
            "name": "string.link.text.twee3",
            "match": "^[^\\]|<\\-\\[]+"
        },
        "sugarcube-link-separator": {
            "name": "punctuation.separator.link.twee3",
            "match": "\\||->|<-"
        },
        "sugarcube-link-target": {
            "name": "string.link.target.twee3",
            "match": "^[^\\]\\[]+"
        },
        "sugarcube-link-setter": {
            "patterns": [
                {
                    "name": "meta.link.setter.twee3",
                    "begin": "\\]\\[",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.separator.link.setter.twee3"
                        }
                    },
                    "end": "(?=\\]\\]|\\]\\[)",
                    "patterns": [
                        {
                            "name": "string.link.setter.twee3",
                            "match": "[^\\]]+"
                        }
                    ]
                }
            ]
        },
        "script-tag": {
            "comment": "HTML Javascript script tag",
            "begin": "(?i)(<)(script)\\b(?=[^>]*(?:(?:type=('text/javascript'|\"text/javascript\")|lang=(javascript|'javascript'|\"javascript\")))?)(?![^/>]*/>\\s*$)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "entity.name.tag.html"
                }
            },
            "end": "(?i)(</)(script)(>)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "entity.name.tag.html"
                },
                "3": {
                    "name": "punctuation.definition.tag.end.html"
                }
            },
            "patterns": [
                {
                    "include": "#tag-internals"
                },
                {
                    "name": "source.js.twee3",
                    "begin": "(>)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.end.html"
                        }
                    },
                    "end": "(?i)(?=</script>)",
                    "patterns": [
                        {
                            "include": "source.js"
                        }
                    ]
                }
            ]
        },
        "style-tag": {
            "comment": "HTML CSS style tag",
            "begin": "(?i)(<)(style)\\b(?=[^>]*(?:(?:type=('text/css'|\"text/css\")|lang=(css|'css'|\"css\")))?)(?![^/>]*/>\\s*$)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "entity.name.tag.html"
                }
            },
            "end": "(?i)(</)(style)(>)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "entity.name.tag.html"
                },
                "3": {
                    "name": "punctuation.definition.tag.end.html"
                }
            },
            "patterns": [
                {
                    "include": "#tag-internals"
                },
                {
                    "name": "source.css.twee3",
                    "begin": "(>)",
                    "beginCaptures": {
                        "1": {
                            "name": "punctuation.definition.tag.end.html"
                        }
                    },
                    "end": "(?i)(?=</style>)",
                    "patterns": [
                        {
                            "include": "source.css"
                        }
                    ]
                }
            ]
        },
        "html-tag": {
            "comment": "Non-specific HTML tag",
            "begin": "(?i)(</?)([a-z][a-zA-Z0-9:-]*)",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.begin.html"
                },
                "2": {
                    "name": "entity.name.tag.other.html"
                }
            },
            "end": "(/?>)",
            "endCaptures": {
                "1": {
                    "name": "punctuation.definition.tag.end.html"
                }
            },
            "name": "meta.tag.other.html",
            "patterns": [
                {
                    "include": "#tag-internals"
                }
            ]
        },
        "tag-internals": {
            "comment": "The internals of an HTML tag",
            "patterns": [
                {
                    "include": "#tag-id-attribute"
                },
                {
                    "include": "#tag-generic-attribute"
                },
                {
                    "include": "#string-double-quoted"
                },
                {
                    "include": "#string-single-quoted"
                }
            ]
        },
        "tag-id-attribute": {
            "name": "meta.attribute-with-value.id.html",
            "begin": "(@?id)\\b\\s*(=)",
            "end": "(?<='|\")",
            "captures": {
                "1": {
                    "name": "entity.other.attribute-name.id.html"
                },
                "2": {
                    "name": "punctuation.separator.key-value.html"
                }
            },
            "patterns": [
                {
                    "name": "string.quoted.double.html",
                    "begin": "\"",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.html"
                        }
                    },
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.html"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#entities"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.html",
                    "begin": "'",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.html"
                        }
                    },
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.html"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#entities"
                        }
                    ]
                }
            ]
        },
        "tag-generic-attribute": {
            "comment": "Generic attribute within an HTML tag",
            "name": "entity.other.attribute-name.html",
            "match": "(@?[a-zA-Z\\-:]+)"
        },
        "string-double-quoted": {
            "comment": "Double-quoted string within an HTML tag",
            "name": "string.quoted.double.html",
            "begin": "\"",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.html"
                }
            },
            "end": "\"",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.html"
                }
            },
            "patterns": [
                {
                    "include": "#entities"
                }
            ]
        },
        "string-single-quoted": {
            "comment": "Single-quoted string within an HTML tag",
            "name": "string.quoted.single.html",
            "begin": "'",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.html"
                }
            },
            "end": "'",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.html"
                }
            },
            "patterns": [
                {
                    "include": "#entities"
                }
            ]
        },
        "entities": {
            "comment": "HTML entities within an HTML tag",
            "patterns": [
                {
                    "name": "constant.character.entity.html",
                    "match": "(&)([a-zA-Z0-9]+|#[0-9]+|#x[0-9a-fA-F]+)(;)",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.entity.html"
                        },
                        "3": {
                            "name": "punctuation.definition.entity.html"
                        }
                    }
                },
                {
                    "name": "invalid.illegal.bad-ampersand.html",
                    "match": "&"
                }
            ]
        },
        "html-comment": {
            "comment": "HTML block comment",
            "name": "comment.block",
            "begin": "<!--",
            "end": "-->"
        }
    },
    "scopeName": "source.twee3.sugarcube-2"
}
